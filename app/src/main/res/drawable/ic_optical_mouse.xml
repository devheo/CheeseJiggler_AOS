<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Mouse Body Shadow -->
    <path
        android:pathData="M100,40 C140,40 160,70 160,110 C160,150 140,170 100,170 C60,170 40,150 40,110 C40,70 60,40 100,40 Z"
        android:fillColor="#10000000" />

    <!-- Mouse Body -->
    <path
        android:pathData="M100,35 C135,35 155,65 155,105 C155,145 135,165 100,165 C65,165 45,145 45,105 C45,65 65,35 100,35 Z"
        android:fillColor="#E0E0E0" />

    <!-- Scroll Wheel Section -->
    <path
        android:pathData="M92,35 L108,35 L108,80 L92,80 Z"
        android:fillColor="#BDBDBD" />

    <!-- Optical Light Glow (The "Beam") -->
    <path
        android:pathData="M100,105 L100,105"
        android:strokeWidth="40"
        android:strokeColor="#FF0000"
        android:strokeLineCap="round">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="100"
                android:centerY="105"
                android:gradientRadius="50"
                android:type="radial">
                <item android:color="#FFFF0000" android:offset="0" />
                <item android:color="#00FF0000" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Center Dot -->
    <path
        android:pathData="M100,105m-8,0a8,8 0,1 1,16 0a8,8 0,1 1,-16 0"
        android:fillColor="#FF5252" />

    <!-- Top Reflection -->
    <path
        android:pathData="M80,45 C90,40 110,40 120,45"
        android:strokeWidth="3"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

</vector>
