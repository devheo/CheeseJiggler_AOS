<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CheeseJiggler" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/cheese_primary</item>
        <item name="colorPrimaryVariant">@color/cheese_primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/cheese_accent</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Adaptive Background/Surface colors. -->
        <item name="android:windowBackground">@color/app_background</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_on_surface</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/android:windowBackground</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.CheeseJiggler.Welcome" parent="Theme.CheeseJiggler">
        <!-- Explicitly Creamy for Welcome if needed, but Theme.CheeseJiggler is now adaptive -->
    </style>
</resources>