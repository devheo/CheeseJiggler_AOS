<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <!-- 상단 툴바 -->
    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_back_desc"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/cheese_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/settings_toolbar_title"
            android:textColor="@color/cheese_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnBookmarks"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/bookmarks_title"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/btn_star_big_off"
            app:tint="@color/cheese_primary" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- 1. 속도 조절 카드 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_speed_label"
                android:textColor="@color/cheese_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:background="@drawable/bg_cheese_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvSpeedTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_speed_format"
                    android:textColor="@color/app_on_surface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/sbSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:max="20"
                    android:progress="5"
                    android:progressTint="@color/cheese_primary"
                    android:thumbTint="@color/cheese_primary" />
            </LinearLayout>

            <!-- 1.2 밝기 조절 카드 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_brightness_label"
                android:textColor="@color/cheese_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:background="@drawable/bg_cheese_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvBrightnessTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_brightness_format"
                    android:textColor="@color/app_on_surface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/sbBrightness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="@color/cheese_primary"
                    android:thumbTint="@color/cheese_primary" />
            </LinearLayout>

            <!-- 2. 동작 및 종료 옵션 카드 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_timer_options_label"
                android:textColor="@color/cheese_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:background="@drawable/bg_cheese_card"
                android:orientation="vertical"
                android:padding="20dp">

                <RadioGroup
                    android:id="@+id/rgTimerType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <RadioButton
                        android:id="@+id/rbTypeInfinite"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/cheese_primary"
                        android:text="@string/settings_timer_infinite"
                        android:textColor="@color/app_on_surface" />

                    <RadioButton
                        android:id="@+id/rbTypeDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/cheese_primary"
                        android:text="@string/settings_timer_duration"
                        android:textColor="@color/app_on_surface" />

                    <RadioButton
                        android:id="@+id/rbTypeTargetTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/cheese_primary"
                        android:text="@string/settings_timer_target"
                        android:textColor="@color/app_on_surface" />

                    <RadioButton
                        android:id="@+id/rbTypeTimeRange"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/cheese_primary"
                        android:text="@string/settings_timer_range"
                        android:textColor="@color/app_on_surface" />

                    <RadioButton
                        android:id="@+id/rbTypeExcludeRange"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/cheese_primary"
                        android:text="@string/settings_timer_exclude"
                        android:textColor="@color/app_on_surface" />
                </RadioGroup>

                <!-- 1) DURATION -->
                <LinearLayout
                    android:id="@+id/layoutDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_duration_label"
                        android:textColor="@color/cheese_primary" />

                    <EditText
                        android:id="@+id/etDurationMinutes"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/cheese_primary"
                        android:inputType="number"
                        android:text="30"
                        android:textColor="@color/app_on_surface" />
                </LinearLayout>

                <!-- 2) TARGET_TIME -->
                <TimePicker
                    android:id="@+id/timePicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:timePickerMode="spinner"
                    android:theme="@style/Widget.MaterialComponents.TimePicker"
                    android:visibility="gone" />

                <!-- 4) TIME_RANGE -->
                <LinearLayout
                    android:id="@+id/layoutTimeRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_start_time_label"
                        android:textColor="@color/cheese_primary"
                        android:textStyle="bold" />

                    <TimePicker
                        android:id="@+id/timePickerStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:timePickerMode="spinner" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/settings_end_time_label"
                        android:textColor="@color/cheese_primary"
                        android:textStyle="bold" />

                    <TimePicker
                        android:id="@+id/timePickerEnd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:timePickerMode="spinner" />
                </LinearLayout>

                <!-- 5) EXCLUDE_RANGE -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManageExclude"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/settings_manage_exclude"
                    android:textColor="@color/cheese_primary"
                    android:visibility="gone"
                    app:icon="@android:drawable/ic_menu_edit"
                    app:iconTint="@color/cheese_primary" />

            </LinearLayout>

            <!-- 3. 스텔스 모드 카드 (시간 설정 전용) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_stealth_label"
                android:textColor="@color/cheese_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:background="@drawable/bg_cheese_card"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:id="@+id/layoutStealth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_stealth_active_label"
                            android:textColor="@color/cheese_primary" />

                        <EditText
                            android:id="@+id/etStealthActive"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/cheese_primary"
                            android:inputType="number"
                            android:text="10"
                            android:textColor="@color/app_on_surface" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_stealth_rest_label"
                            android:textColor="@color/cheese_primary" />

                        <EditText
                            android:id="@+id/etStealthRest"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/cheese_primary"
                            android:inputType="number"
                            android:text="30"
                            android:textColor="@color/app_on_surface" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 4. 타일 패턴 선택 카드 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_tile_label"
                android:textColor="@color/cheese_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:background="@drawable/bg_cheese_card"
                android:orientation="vertical"
                android:padding="20dp">

                <RadioGroup
                    android:id="@+id/rgTileType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <RadioButton
                            android:id="@+id/rbTileBasic"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:buttonTint="@color/cheese_primary"
                            android:text="@string/settings_tile_basic"
                            android:textColor="@color/app_on_surface" />
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/tile_preview_basic"
                            android:padding="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <RadioButton
                            android:id="@+id/rbTileGrid"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:buttonTint="@color/cheese_primary"
                            android:text="@string/settings_tile_grid"
                            android:textColor="@color/app_on_surface" />
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/tile_preview_grid"
                            android:padding="4dp" />
                    </LinearLayout>

                    <!-- ... other tiles follow same pattern ... -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <RadioButton
                            android:id="@+id/rbTileVStripe"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:buttonTint="@color/cheese_primary"
                            android:text="@string/settings_tile_v_stripe"
                            android:textColor="@color/app_on_surface" />
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/tile_preview_v_stripe"
                            android:padding="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <RadioButton
                            android:id="@+id/rbTileDStripe"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:buttonTint="@color/cheese_primary"
                            android:text="@string/settings_tile_d_stripe"
                            android:textColor="@color/app_on_surface" />
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/tile_preview_d_stripe"
                            android:padding="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <RadioButton
                            android:id="@+id/rbTileDots"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:buttonTint="@color/cheese_primary"
                            android:text="@string/settings_tile_dots"
                            android:textColor="@color/app_on_surface" />
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/tile_preview_dots"
                            android:padding="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <RadioButton
                            android:id="@+id/rbTileWideStripes"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:buttonTint="@color/cheese_primary"
                            android:text="@string/settings_tile_wide_stripes"
                            android:textColor="@color/app_on_surface" />
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/tile_preview_wide_stripe"
                            android:padding="4dp" />
                    </LinearLayout>
                </RadioGroup>
            </LinearLayout>

            <!-- 5. 움직임 패턴 선택 카드 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_move_pattern_label"
                android:textColor="@color/cheese_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:background="@drawable/bg_cheese_card"
                android:orientation="vertical"
                android:padding="20dp">

                <RadioGroup
                    android:id="@+id/rgMovePattern"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbPatternBasic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/cheese_primary"
                        android:checked="true"
                        android:text="@string/settings_move_basic"
                        android:textColor="@color/app_on_surface" />

                    <RadioButton
                        android:id="@+id/rbPatternCircle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/cheese_primary"
                        android:text="@string/settings_move_circle"
                        android:textColor="@color/app_on_surface" />

                    <RadioButton
                        android:id="@+id/rbPatternZigzag"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/cheese_primary"
                        android:text="@string/settings_move_zigzag"
                        android:textColor="@color/app_on_surface" />

                    <RadioButton
                        android:id="@+id/rbPatternMicro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/cheese_primary"
                        android:text="@string/settings_move_micro"
                        android:textColor="@color/app_on_surface" />
                </RadioGroup>

            </LinearLayout>

            <!-- 저장하기 버튼들 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSavePreset"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/bookmark_save_title"
                    android:textAllCaps="false"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/cheese_primary"
                    android:textColor="@color/cheese_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="@string/settings_save_button"
                    android:textAllCaps="false"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:backgroundTint="@color/cheese_primary"
                    android:textColor="@color/cheese_text_on_primary" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
