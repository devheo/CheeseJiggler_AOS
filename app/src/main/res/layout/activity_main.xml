<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- 바둑판 지글러 화면 -->
    <com.nicsy.cheese.jiggler.layout.JigglerGridLayout
        android:id="@+id/jigglerGridLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <!-- 우측 상단 버튼들 -->
    <LinearLayout
        android:id="@+id/layoutTopButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:orientation="horizontal">

        <!-- 원격 조정 바로가기 버튼 (연결된 경우만 노출) -->
        <ImageButton
            android:id="@+id/btnRemoteShortcut"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/remote_shortcut_desc"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_optical_mouse"
            android:visibility="gone"
            app:tint="@color/cheese_primary" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/main_settings_desc"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ico_app_settings"
            app:tint="@color/cheese_primary" />
    </LinearLayout>

    <!-- 상태 및 안내 텍스트 -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_above="@id/layoutMainStealth"
        android:layout_marginBottom="24dp"
        android:textColor="@color/cheese_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutMainStealth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/fabPlay"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_cheese_card"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_stealth_label"
            android:textColor="@color/app_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swMainStealth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:thumbTint="@color/cheese_primary"
            app:trackTint="@color/cheese_accent" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabPlay"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="40dp"
        android:contentDescription="@string/main_play_desc"
        android:src="@drawable/ico_app_play"
        app:maxImageSize="72dp"
        android:scaleType="centerCrop"
        app:fabCustomSize="80dp"
        app:tint="@null"
        app:backgroundTint="@color/cheese_primary" />
</RelativeLayout>