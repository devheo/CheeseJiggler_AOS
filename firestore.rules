rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Devices collection: Stores device status and remote commands
    match /devices/{userId} {
      // The owner has full access
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Controllers (other authenticated users) can read status and send commands
      // We restrict updates from non-owners to specific fields for better security
      allow read: if request.auth != null;
      allow update: if request.auth != null &&
                    request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny(['lastCommand', 'status', 'timestamp']);
    }

    // Codes collection: Maps 6-digit codes to device UIDs
    match /codes/{code} {
      allow read: if request.auth != null;
      // Only the device owner can create/update their own code mapping
      allow write: if request.auth != null &&
                   get(/databases/$(database)/documents/devices/$(request.auth.uid)).data.code == code;
    }
  }
}
